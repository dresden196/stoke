#: stoke/bootrec.py:50
#, python-format
msgid "unknown MBR type %s"
msgstr "tipo di MBR sconosciuto: %s"

#: stoke/bootrec.py:119
msgid ""
"not enough space before the first partition for the boot loader (uncheck "
"'Add fixes for old BIOSes')"
msgstr "spazio insufficiente prima della prima partizione per il boot loader (deseleziona 'Aggiungi correzioni per BIOS datati')"

#: stoke/bootrec.py:152
msgid "new volume does not have an NTFS boot sector"
msgstr "il nuovo volume non ha un settore di avvio NTFS"

#: stoke/bootrec.py:160
msgid "new volume does not have a FAT32 boot sector"
msgstr "il nuovo volume non ha un settore di avvio FAT32"

#: stoke/bootrec.py:192
msgid "new volume does not have a FAT16 boot sector"
msgstr "il nuovo volume non ha un settore di avvio FAT16"

#: stoke/bootrec.py:203
#, python-format
msgid "no boot record support for %s"
msgstr "nessun supporto per il record di avvio per %s"

#: stoke/cli.py:17
msgid "Writing a drive needs root: run through pkexec or sudo"
msgstr "La scrittura di un'unità richiede i permessi di root: eseguilo tramite pkexec o sudo"

#: stoke/cli.py:116 stoke/job.py:145
#, python-format
msgid "%s is not a disk"
msgstr "%s non è un disco"

#: stoke/extract.py:180
#, python-format
msgid "'%s' is %s: FAT32 cannot hold files over 4 GB. Use NTFS or exFAT."
msgstr "'%s' è %s: FAT32 non può contenere file superiori a 4 GB. Usa NTFS o exFAT."

#: stoke/extract.py:185
#, python-format
msgid "could not write %s: %s"
msgstr "impossibile scrivere %s: %s"

#: stoke/extract.py:203
#, python-format
msgid ""
"splitting %s needs %s of temporary space in %s, only %s free. Use NTFS "
"instead of FAT32, or set TMPDIR to a larger location."
msgstr "la suddivisione di %s richiede %s di spazio temporaneo in %s, solo %s disponibile. Usa NTFS invece di FAT32, oppure imposta TMPDIR su una posizione più capiente."

#: stoke/extract.py:213
msgid "Splitting install.wim for FAT32..."
msgstr "Suddivisione di install.wim per FAT32..."

#: stoke/fs.py:110 stoke/job.py:124 stoke/layout.py:163
#, python-format
msgid "unsupported file system %s"
msgstr "file system non supportato: %s"

#: stoke/image.py:69
#, python-format
msgid "%s is not a file"
msgstr "%s non è un file"

#: stoke/job.py:96
#, python-format
msgid "unknown boot type %s"
msgstr "tipo di avvio sconosciuto: %s"

#: stoke/job.py:120
msgid "scheme must be mbr or gpt"
msgstr "lo schema deve essere mbr o gpt"

#: stoke/job.py:122
msgid "target must be bios, uefi or dual"
msgstr "la destinazione deve essere bios, uefi o dual"

#: stoke/job.py:126
msgid "no image given"
msgstr "nessuna immagine specificata"

#: stoke/job.py:128
msgid "no device given"
msgstr "nessun dispositivo specificato"

#: stoke/job.py:130
msgid "GPT needs a UEFI target"
msgstr "GPT richiede una destinazione UEFI"

#: stoke/job.py:132
msgid "UEFI:NTFS needs an NTFS or exFAT main partition"
msgstr "UEFI:NTFS richiede una partizione principale NTFS o exFAT"

#: stoke/job.py:144
#, python-format
msgid "%s holds the running system; refusing to write it"
msgstr "%s contiene il sistema in esecuzione; scrittura rifiutata"

#: stoke/job.py:147
#, python-format
msgid "%s is an internal drive; refusing to write it"
msgstr "%s è un'unità interna; scrittura rifiutata"

#: stoke/job.py:149
#, python-format
msgid "%s is a loop device; refusing to write it"
msgstr "%s è un dispositivo loop; scrittura rifiutata"

#: stoke/job.py:158
msgid "Scanning image..."
msgstr "Analisi dell'immagine in corso..."

#: stoke/job.py:162
msgid "this ISO is not a hybrid image and cannot be written in DD mode"
msgstr "questa ISO non è un'immagine ibrida e non può essere scritta in modalità DD"

#: stoke/job.py:166
msgid "Windows To Go needs an image with sources/install.wim"
msgstr "Windows To Go richiede un'immagine con sources/install.wim"

#: stoke/job.py:168
msgid "Windows To Go needs NTFS"
msgstr "Windows To Go richiede NTFS"

#: stoke/job.py:170
msgid "this image has files over 4 GB that cannot be split; use NTFS or exFAT"
msgstr "questa immagine contiene file superiori a 4 GB che non possono essere suddivisi; usa NTFS o exFAT"

#: stoke/job.py:172
msgid "this image does not support a persistent partition"
msgstr "questa immagine non supporta una partizione persistente"

#: stoke/job.py:174
msgid ""
"this image has files over 4 GB; FAT32 cannot hold them, use NTFS or exFAT"
msgstr "questa immagine contiene file superiori a 4 GB; FAT32 non può contenerli, usa NTFS o exFAT"

#: stoke/job.py:176
#, python-format
msgid "the image needs %s but the drive has %s"
msgstr "l'immagine richiede %s ma l'unità dispone di %s"

#: stoke/job.py:228
msgid "Writing image..."
msgstr "Scrittura dell'immagine in corso..."

#: stoke/job.py:230 stoke/job.py:393
msgid "Finalizing..."
msgstr "Finalizzazione in corso..."

#: stoke/job.py:234
msgid "Zeroing drive..."
msgstr "Azzeramento dell'unità in corso..."

#: stoke/job.py:239
msgid "Creating partition table..."
msgstr "Creazione della tabella delle partizioni in corso..."

#: stoke/job.py:264
msgid "Formatting..."
msgstr "Formattazione in corso..."

#: stoke/job.py:285
msgid "Writing boot records..."
msgstr "Scrittura dei record di avvio in corso..."

#: stoke/job.py:321
msgid "Copying files..."
msgstr "Copia dei file in corso..."

#: stoke/job.py:321
msgid "Preparing volume..."
msgstr "Preparazione del volume in corso..."

#: stoke/job.py:333
msgid "could not read the partition GUIDs back from the new table"
msgstr "impossibile rileggere i GUID delle partizioni dalla nuova tabella"

#: stoke/job.py:383
msgid "Applying customization..."
msgstr "Applicazione della personalizzazione in corso..."

#: stoke/job.py:383
msgid "Finalizing files..."
msgstr "Finalizzazione dei file in corso..."

#: stoke/job.py:434
msgid "Checking for bad blocks..."
msgstr "Controllo dei blocchi danneggiati in corso..."

#: stoke/job.py:465
#, python-format
msgid ""
"bad blocks check found %d bad block(s); this drive should not be trusted"
msgstr "il controllo dei blocchi danneggiati ha trovato %d blocco/i danneggiato/i; questa unità non è affidabile"

#: stoke/job.py:478
#, python-format
msgid ""
"Windows To Go needs %s of temporary space in %s; only %s is free (set TMPDIR "
"to a larger location)"
msgstr "Windows To Go richiede %s di spazio temporaneo in %s; solo %s disponibile (imposta TMPDIR su una posizione più capiente)"

#: stoke/job.py:481
msgid "Extracting install image..."
msgstr "Estrazione dell'immagine di installazione in corso..."

#: stoke/job.py:498
msgid "image has no BCD template to build the boot store from"
msgstr "l'immagine non ha un modello BCD da cui creare l'archivio di avvio"

#: stoke/layout.py:68
#, python-format
msgid "unknown partition scheme %s"
msgstr "schema di partizionamento sconosciuto: %s"

#: stoke/layout.py:93
msgid "an MSR partition needs GPT"
msgstr "una partizione MSR richiede GPT"

#: stoke/layout.py:110
msgid "persistence requested with no size"
msgstr "persistenza richiesta senza una dimensione"

#: stoke/layout.py:138
msgid "too many partitions"
msgstr "troppe partizioni"

#: stoke/layout.py:146
#, python-format
msgid "%s does not fit on this drive"
msgstr "%s non entra in questa unità"

#: stoke/layout.py:150 stoke/layout.py:155
msgid "drive is too small for this layout"
msgstr "l'unità è troppo piccola per questa disposizione"

#: stoke/layout.py:247
#, python-format
msgid "%s did not appear after partitioning"
msgstr "%s non è comparso dopo il partizionamento"

#: stoke/linux.py:99
#, python-format
msgid "extlinux failed: %s"
msgstr "extlinux non riuscito: %s"

#: stoke/mountctl.py:82
#, python-format
msgid "%s is active swap; deactivate it first"
msgstr "%s è swap attivo; disattivalo prima"

#: stoke/mountctl.py:93
#, python-format
msgid "%s is in use (%s); close anything using it and try again"
msgstr "%s è in uso (%s); chiudi tutto ciò che lo utilizza e riprova"

#: stoke/mountctl.py:128
#, python-format
msgid "could not mount %s (%s): %s"
msgstr "impossibile montare %s (%s): %s"

#: stoke/mountctl.py:128
msgid "no mount helper"
msgstr "nessun helper di montaggio"

#: stoke/util.py:147
#, python-format
msgid "'%s' is not available on this system%s"
msgstr "'%s' non è disponibile su questo sistema%s"

#: stoke/util.py:180 stoke/wim.py:114
#, python-format
msgid "%s failed: %s"
msgstr "%s non riuscito: %s"

#: stoke/util.py:212
#, python-format
msgid "short write to %s at %s"
msgstr "scrittura incompleta su %s a %s"

#: stoke/util.py:226
#, python-format
msgid "missing payload file: %s"
msgstr "file di payload mancante: %s"

#: stoke/wim.py:59 stoke/wim.py:75
#, python-format
msgid "%s is not a WIM file"
msgstr "%s non è un file WIM"

#: stoke/wim.py:63
#, python-format
msgid "%s has no XML index"
msgstr "%s non ha un indice XML"

#: stoke/wim.py:131
#, python-format
msgid "wimupdate failed: %s"
msgstr "wimupdate non riuscito: %s"

#: stoke/wim.py:170
#, python-format
msgid "wimapply failed: %s"
msgstr "wimapply non riuscito: %s"

#: stoke/windows.py:73
msgid "SYSTEM hive has no Setup key"
msgstr "l'hive SYSTEM non ha la chiave Setup"

#: stoke/windows.py:97
msgid "Applying Windows customization..."
msgstr "Applicazione della personalizzazione di Windows in corso..."

#: stoke/windows.py:171
msgid "sources/boot.wim not found; cannot add the answer file"
msgstr "sources/boot.wim non trovato; impossibile aggiungere il file di risposta"

#: stoke/windows.py:187
msgid "Updating boot.wim..."
msgstr "Aggiornamento di boot.wim in corso..."

#: stoke/windows.py:272
#, python-format
msgid "%s\\%s not found on the media"
msgstr "%s\\%s non trovato sul supporto"

#: stoke/windows.py:289
msgid ""
"media has \\minint but no /minint option and no \\i386: unsure how to boot it"
msgstr "il supporto ha \\minint ma nessuna opzione /minint e nessun \\i386: non è chiaro come avviarlo"

#: stoke/windows.py:353
#, python-format
msgid "%s not found in %s"
msgstr "%s non trovato in %s"

#: stoke/windows.py:385
msgid "no OS loader entry in the BCD template"
msgstr "nessuna voce di caricamento del sistema operativo nel modello BCD"

#: stoke/windows.py:480
msgid "Applying Windows image (this takes a while)..."
msgstr "Applicazione dell'immagine di Windows in corso (richiede un po' di tempo)..."

#: stoke/windows.py:488
msgid "applied image has no Windows directory"
msgstr "l'immagine applicata non ha una cartella Windows"

#: stoke/windows.py:500
msgid "applied image has no Windows\\Boot\\EFI"
msgstr "l'immagine applicata non ha Windows\\Boot\\EFI"

#: stoke/windows.py:558
#, python-format
msgid "could not mount %s (NTFS): neither ntfs3 nor ntfs-3g worked"
msgstr "impossibile montare %s (NTFS): né ntfs3 né ntfs-3g hanno funzionato"

#: stoke/writer.py:50
msgid ""
"only fixed-size VHD images can be written; convert dynamic VHD/VHDX with "
"qemu-img first"
msgstr "possono essere scritte solo immagini VHD a dimensione fissa; converti prima i VHD/VHDX dinamici con qemu-img"

#: stoke/writer.py:90
#, python-format
msgid "image is %s but the drive holds only %s"
msgstr "l'immagine è %s ma l'unità dispone solo di %s"

#: stoke/writer.py:111
msgid "image is larger than the drive"
msgstr "l'immagine è più grande dell'unità"

#: stoke/writer.py:156
#, python-format
msgid ""
"verification failed at offset %s: the drive does not hold what was written"
msgstr "verifica non riuscita all'offset %s: l'unità non contiene ciò che è stato scritto"
