#: stoke/bootrec.py:50
#, python-format
msgid "unknown MBR type %s"
msgstr "未知的 MBR 类型 %s"

#: stoke/bootrec.py:119
msgid ""
"not enough space before the first partition for the boot loader (uncheck "
"'Add fixes for old BIOSes')"
msgstr "第一个分区之前的空间不足,无法放置引导加载程序(请取消勾选“为旧版 BIOS 添加修复”)"

#: stoke/bootrec.py:152
msgid "new volume does not have an NTFS boot sector"
msgstr "新卷没有 NTFS 引导扇区"

#: stoke/bootrec.py:160
msgid "new volume does not have a FAT32 boot sector"
msgstr "新卷没有 FAT32 引导扇区"

#: stoke/bootrec.py:192
msgid "new volume does not have a FAT16 boot sector"
msgstr "新卷没有 FAT16 引导扇区"

#: stoke/bootrec.py:203
#, python-format
msgid "no boot record support for %s"
msgstr "不支持 %s 的引导记录"

#: stoke/cli.py:17
msgid "Writing a drive needs root: run through pkexec or sudo"
msgstr "写入驱动器需要 root 权限:请通过 pkexec 或 sudo 运行"

#: stoke/cli.py:116 stoke/job.py:145
#, python-format
msgid "%s is not a disk"
msgstr "%s 不是磁盘"

#: stoke/extract.py:180
#, python-format
msgid "'%s' is %s: FAT32 cannot hold files over 4 GB. Use NTFS or exFAT."
msgstr "“%s”为 %s:FAT32 无法保存超过 4 GB 的文件,请使用 NTFS 或 exFAT。"

#: stoke/extract.py:185
#, python-format
msgid "could not write %s: %s"
msgstr "无法写入 %s:%s"

#: stoke/extract.py:203
#, python-format
msgid ""
"splitting %s needs %s of temporary space in %s, only %s free. Use NTFS "
"instead of FAT32, or set TMPDIR to a larger location."
msgstr "拆分 %s 需要在 %s 中占用 %s 的临时空间,但只有 %s 可用。请改用 NTFS 而不是 FAT32,或将 TMPDIR 设置为空间更大的位置。"

#: stoke/extract.py:213
msgid "Splitting install.wim for FAT32..."
msgstr "正在为 FAT32 拆分 install.wim…"

#: stoke/fs.py:110 stoke/job.py:124 stoke/layout.py:163
#, python-format
msgid "unsupported file system %s"
msgstr "不支持的文件系统:%s"

#: stoke/image.py:69
#, python-format
msgid "%s is not a file"
msgstr "%s 不是文件"

#: stoke/job.py:96
#, python-format
msgid "unknown boot type %s"
msgstr "未知的引导类型:%s"

#: stoke/job.py:120
msgid "scheme must be mbr or gpt"
msgstr "分区方案必须为 mbr 或 gpt"

#: stoke/job.py:122
msgid "target must be bios, uefi or dual"
msgstr "目标系统必须为 bios、uefi 或 dual"

#: stoke/job.py:126
msgid "no image given"
msgstr "未指定映像"

#: stoke/job.py:128
msgid "no device given"
msgstr "未指定设备"

#: stoke/job.py:130
msgid "GPT needs a UEFI target"
msgstr "GPT 需要 UEFI 目标系统"

#: stoke/job.py:132
msgid "UEFI:NTFS needs an NTFS or exFAT main partition"
msgstr "UEFI:NTFS 需要 NTFS 或 exFAT 主分区"

#: stoke/job.py:144
#, python-format
msgid "%s holds the running system; refusing to write it"
msgstr "%s 中包含正在运行的系统,拒绝写入"

#: stoke/job.py:147
#, python-format
msgid "%s is an internal drive; refusing to write it"
msgstr "%s 是内部驱动器,拒绝写入"

#: stoke/job.py:149
#, python-format
msgid "%s is a loop device; refusing to write it"
msgstr "%s 是环回设备,拒绝写入"

#: stoke/job.py:158
msgid "Scanning image..."
msgstr "正在扫描映像…"

#: stoke/job.py:162
msgid "this ISO is not a hybrid image and cannot be written in DD mode"
msgstr "此 ISO 不是混合映像,无法以 DD 模式写入"

#: stoke/job.py:166
msgid "Windows To Go needs an image with sources/install.wim"
msgstr "Windows To Go 需要包含 sources/install.wim 的映像"

#: stoke/job.py:168
msgid "Windows To Go needs NTFS"
msgstr "Windows To Go 需要 NTFS"

#: stoke/job.py:170
msgid "this image has files over 4 GB that cannot be split; use NTFS or exFAT"
msgstr "此映像包含无法拆分的超过 4 GB 的文件,请使用 NTFS 或 exFAT"

#: stoke/job.py:172
msgid "this image does not support a persistent partition"
msgstr "此映像不支持持久分区"

#: stoke/job.py:174
msgid ""
"this image has files over 4 GB; FAT32 cannot hold them, use NTFS or exFAT"
msgstr "此映像包含超过 4 GB 的文件,FAT32 无法保存,请使用 NTFS 或 exFAT"

#: stoke/job.py:176
#, python-format
msgid "the image needs %s but the drive has %s"
msgstr "此映像需要 %s,但驱动器只有 %s"

#: stoke/job.py:228
msgid "Writing image..."
msgstr "正在写入映像…"

#: stoke/job.py:230 stoke/job.py:393
msgid "Finalizing..."
msgstr "正在完成收尾…"

#: stoke/job.py:234
msgid "Zeroing drive..."
msgstr "正在清零驱动器…"

#: stoke/job.py:239
msgid "Creating partition table..."
msgstr "正在创建分区表…"

#: stoke/job.py:264
msgid "Formatting..."
msgstr "正在格式化…"

#: stoke/job.py:285
msgid "Writing boot records..."
msgstr "正在写入引导记录…"

#: stoke/job.py:321
msgid "Copying files..."
msgstr "正在复制文件…"

#: stoke/job.py:321
msgid "Preparing volume..."
msgstr "正在准备卷…"

#: stoke/job.py:333
msgid "could not read the partition GUIDs back from the new table"
msgstr "无法从新分区表中读回分区 GUID"

#: stoke/job.py:383
msgid "Applying customization..."
msgstr "正在应用自定义设置…"

#: stoke/job.py:383
msgid "Finalizing files..."
msgstr "正在完成文件处理…"

#: stoke/job.py:434
msgid "Checking for bad blocks..."
msgstr "正在检查坏块…"

#: stoke/job.py:465
#, python-format
msgid ""
"bad blocks check found %d bad block(s); this drive should not be trusted"
msgstr "坏块检查发现 %d 个坏块;此驱动器不可信"

#: stoke/job.py:478
#, python-format
msgid ""
"Windows To Go needs %s of temporary space in %s; only %s is free (set TMPDIR "
"to a larger location)"
msgstr "Windows To Go 需要在 %s 中占用 %s 的临时空间,但只有 %s 可用(请将 TMPDIR 设置为空间更大的位置)"

#: stoke/job.py:481
msgid "Extracting install image..."
msgstr "正在提取安装映像…"

#: stoke/job.py:498
msgid "image has no BCD template to build the boot store from"
msgstr "映像中没有可用于构建引导存储的 BCD 模板"

#: stoke/layout.py:68
#, python-format
msgid "unknown partition scheme %s"
msgstr "未知的分区方案:%s"

#: stoke/layout.py:93
msgid "an MSR partition needs GPT"
msgstr "MSR 分区需要 GPT"

#: stoke/layout.py:110
msgid "persistence requested with no size"
msgstr "请求了持久化,但未指定大小"

#: stoke/layout.py:138
msgid "too many partitions"
msgstr "分区数量过多"

#: stoke/layout.py:146
#, python-format
msgid "%s does not fit on this drive"
msgstr "%s 无法容纳在此驱动器上"

#: stoke/layout.py:150 stoke/layout.py:155
msgid "drive is too small for this layout"
msgstr "驱动器容量太小,无法容纳此布局"

#: stoke/layout.py:247
#, python-format
msgid "%s did not appear after partitioning"
msgstr "分区完成后未出现 %s"

#: stoke/linux.py:99
#, python-format
msgid "extlinux failed: %s"
msgstr "extlinux 失败:%s"

#: stoke/mountctl.py:82
#, python-format
msgid "%s is active swap; deactivate it first"
msgstr "%s 是正在使用的交换分区,请先禁用它"

#: stoke/mountctl.py:93
#, python-format
msgid "%s is in use (%s); close anything using it and try again"
msgstr "%s 正在使用中(%s),请关闭正在使用它的程序后重试"

#: stoke/mountctl.py:128
#, python-format
msgid "could not mount %s (%s): %s"
msgstr "无法挂载 %s(%s):%s"

#: stoke/mountctl.py:128
msgid "no mount helper"
msgstr "没有可用的挂载助手"

#: stoke/util.py:147
#, python-format
msgid "'%s' is not available on this system%s"
msgstr "“%s” 在此系统上不可用%s"

#: stoke/util.py:180 stoke/wim.py:114
#, python-format
msgid "%s failed: %s"
msgstr "%s 失败:%s"

#: stoke/util.py:212
#, python-format
msgid "short write to %s at %s"
msgstr "写入 %s(位置 %s)时数据不完整"

#: stoke/util.py:226
#, python-format
msgid "missing payload file: %s"
msgstr "缺少负载文件:%s"

#: stoke/wim.py:59 stoke/wim.py:75
#, python-format
msgid "%s is not a WIM file"
msgstr "%s 不是 WIM 文件"

#: stoke/wim.py:63
#, python-format
msgid "%s has no XML index"
msgstr "%s 没有 XML 索引"

#: stoke/wim.py:131
#, python-format
msgid "wimupdate failed: %s"
msgstr "wimupdate 失败:%s"

#: stoke/wim.py:170
#, python-format
msgid "wimapply failed: %s"
msgstr "wimapply 失败:%s"

#: stoke/windows.py:73
msgid "SYSTEM hive has no Setup key"
msgstr "SYSTEM 注册表配置单元中没有 Setup 键"

#: stoke/windows.py:97
msgid "Applying Windows customization..."
msgstr "正在应用 Windows 自定义设置…"

#: stoke/windows.py:171
msgid "sources/boot.wim not found; cannot add the answer file"
msgstr "未找到 sources/boot.wim,无法添加应答文件"

#: stoke/windows.py:187
msgid "Updating boot.wim..."
msgstr "正在更新 boot.wim…"

#: stoke/windows.py:272
#, python-format
msgid "%s\\%s not found on the media"
msgstr "介质上未找到 %s\\%s"

#: stoke/windows.py:289
msgid ""
"media has \\minint but no /minint option and no \\i386: unsure how to boot it"
msgstr "介质中包含 \\minint,但没有 /minint 选项也没有 \\i386:无法确定启动方式"

#: stoke/windows.py:353
#, python-format
msgid "%s not found in %s"
msgstr "在 %s 中未找到 %s"

#: stoke/windows.py:385
msgid "no OS loader entry in the BCD template"
msgstr "BCD 模板中没有操作系统加载程序条目"

#: stoke/windows.py:480
msgid "Applying Windows image (this takes a while)..."
msgstr "正在应用 Windows 映像(需要一段时间)…"

#: stoke/windows.py:488
msgid "applied image has no Windows directory"
msgstr "已应用的映像中没有 Windows 目录"

#: stoke/windows.py:500
msgid "applied image has no Windows\\Boot\\EFI"
msgstr "已应用的映像中没有 Windows\\Boot\\EFI"

#: stoke/windows.py:558
#, python-format
msgid "could not mount %s (NTFS): neither ntfs3 nor ntfs-3g worked"
msgstr "无法挂载 %s(NTFS):ntfs3 和 ntfs-3g 均无法使用"

#: stoke/writer.py:50
msgid ""
"only fixed-size VHD images can be written; convert dynamic VHD/VHDX with "
"qemu-img first"
msgstr "只能写入固定大小的 VHD 映像;请先使用 qemu-img 转换动态 VHD/VHDX"

#: stoke/writer.py:90
#, python-format
msgid "image is %s but the drive holds only %s"
msgstr "映像大小为 %s,但驱动器容量只有 %s"

#: stoke/writer.py:111
msgid "image is larger than the drive"
msgstr "映像大于驱动器容量"

#: stoke/writer.py:156
#, python-format
msgid ""
"verification failed at offset %s: the drive does not hold what was written"
msgstr "在偏移量 %s 处验证失败:驱动器中的内容与写入的数据不一致"