#: stoke/bootrec.py:50
#, python-format
msgid "unknown MBR type %s"
msgstr "невідомий тип MBR %s"

#: stoke/bootrec.py:119
msgid ""
"not enough space before the first partition for the boot loader (uncheck "
"'Add fixes for old BIOSes')"
msgstr "недостатньо місця перед першим розділом для завантажувача (зніміть позначку «Додати виправлення для старих BIOS»)"

#: stoke/bootrec.py:152
msgid "new volume does not have an NTFS boot sector"
msgstr "новий том не має завантажувального сектора NTFS"

#: stoke/bootrec.py:160
msgid "new volume does not have a FAT32 boot sector"
msgstr "новий том не має завантажувального сектора FAT32"

#: stoke/bootrec.py:192
msgid "new volume does not have a FAT16 boot sector"
msgstr "новий том не має завантажувального сектора FAT16"

#: stoke/bootrec.py:203
#, python-format
msgid "no boot record support for %s"
msgstr "немає підтримки завантажувального запису для %s"

#: stoke/cli.py:17
msgid "Writing a drive needs root: run through pkexec or sudo"
msgstr "Запис на диск потребує прав root: запустіть через pkexec або sudo"

#: stoke/cli.py:116 stoke/job.py:145
#, python-format
msgid "%s is not a disk"
msgstr "%s не є диском"

#: stoke/extract.py:180
#, python-format
msgid "'%s' is %s: FAT32 cannot hold files over 4 GB. Use NTFS or exFAT."
msgstr "«%s» має розмір %s: FAT32 не підтримує файли розміром понад 4 ГБ. Використайте NTFS або exFAT."

#: stoke/extract.py:185
#, python-format
msgid "could not write %s: %s"
msgstr "не вдалося записати %s: %s"

#: stoke/extract.py:203
#, python-format
msgid ""
"splitting %s needs %s of temporary space in %s, only %s free. Use NTFS "
"instead of FAT32, or set TMPDIR to a larger location."
msgstr "для поділу %s потрібно %s тимчасового місця в %s, доступно лише %s. Використайте NTFS замість FAT32 або вкажіть у TMPDIR каталог із більшим обсягом вільного місця."

#: stoke/extract.py:213
msgid "Splitting install.wim for FAT32..."
msgstr "Поділ install.wim для FAT32…"

#: stoke/fs.py:110 stoke/job.py:124 stoke/layout.py:163
#, python-format
msgid "unsupported file system %s"
msgstr "непідтримувана файлова система %s"

#: stoke/image.py:69
#, python-format
msgid "%s is not a file"
msgstr "%s не є файлом"

#: stoke/job.py:96
#, python-format
msgid "unknown boot type %s"
msgstr "невідомий тип завантаження %s"

#: stoke/job.py:120
msgid "scheme must be mbr or gpt"
msgstr "схема розділів має бути mbr або gpt"

#: stoke/job.py:122
msgid "target must be bios, uefi or dual"
msgstr "цільова система має бути bios, uefi або dual"

#: stoke/job.py:126
msgid "no image given"
msgstr "не вказано образ"

#: stoke/job.py:128
msgid "no device given"
msgstr "не вказано пристрій"

#: stoke/job.py:130
msgid "GPT needs a UEFI target"
msgstr "GPT потребує цільової системи UEFI"

#: stoke/job.py:132
msgid "UEFI:NTFS needs an NTFS or exFAT main partition"
msgstr "UEFI:NTFS потребує основного розділу NTFS або exFAT"

#: stoke/job.py:144
#, python-format
msgid "%s holds the running system; refusing to write it"
msgstr "%s містить запущену систему; запис відхилено"

#: stoke/job.py:147
#, python-format
msgid "%s is an internal drive; refusing to write it"
msgstr "%s є внутрішнім диском; запис відхилено"

#: stoke/job.py:149
#, python-format
msgid "%s is a loop device; refusing to write it"
msgstr "%s є loop-пристроєм; запис відхилено"

#: stoke/job.py:158
msgid "Scanning image..."
msgstr "Сканування образу…"

#: stoke/job.py:162
msgid "this ISO is not a hybrid image and cannot be written in DD mode"
msgstr "цей ISO не є гібридним образом і не може бути записаний у режимі DD"

#: stoke/job.py:166
msgid "Windows To Go needs an image with sources/install.wim"
msgstr "Windows To Go потребує образу з sources/install.wim"

#: stoke/job.py:168
msgid "Windows To Go needs NTFS"
msgstr "Windows To Go потребує NTFS"

#: stoke/job.py:170
msgid "this image has files over 4 GB that cannot be split; use NTFS or exFAT"
msgstr "цей образ містить файли розміром понад 4 ГБ, які неможливо поділити; використайте NTFS або exFAT"

#: stoke/job.py:172
msgid "this image does not support a persistent partition"
msgstr "цей образ не підтримує постійний розділ"

#: stoke/job.py:174
msgid ""
"this image has files over 4 GB; FAT32 cannot hold them, use NTFS or exFAT"
msgstr "цей образ містить файли розміром понад 4 ГБ; FAT32 їх не підтримує, використайте NTFS або exFAT"

#: stoke/job.py:176
#, python-format
msgid "the image needs %s but the drive has %s"
msgstr "образу потрібно %s, а на диску є лише %s"

#: stoke/job.py:228
msgid "Writing image..."
msgstr "Запис образу…"

#: stoke/job.py:230 stoke/job.py:393
msgid "Finalizing..."
msgstr "Завершення…"

#: stoke/job.py:234
msgid "Zeroing drive..."
msgstr "Обнулення диска…"

#: stoke/job.py:239
msgid "Creating partition table..."
msgstr "Створення таблиці розділів…"

#: stoke/job.py:264
msgid "Formatting..."
msgstr "Форматування…"

#: stoke/job.py:285
msgid "Writing boot records..."
msgstr "Запис завантажувальних записів…"

#: stoke/job.py:321
msgid "Copying files..."
msgstr "Копіювання файлів…"

#: stoke/job.py:321
msgid "Preparing volume..."
msgstr "Підготовка тому…"

#: stoke/job.py:333
msgid "could not read the partition GUIDs back from the new table"
msgstr "не вдалося прочитати GUID розділів із нової таблиці"

#: stoke/job.py:383
msgid "Applying customization..."
msgstr "Застосування налаштувань…"

#: stoke/job.py:383
msgid "Finalizing files..."
msgstr "Завершення запису файлів…"

#: stoke/job.py:434
msgid "Checking for bad blocks..."
msgstr "Перевірка на пошкоджені блоки…"

#: stoke/job.py:465
#, python-format
msgid ""
"bad blocks check found %d bad block(s); this drive should not be trusted"
msgstr "перевірка виявила пошкоджених блоків: %d; цьому диску не варто довіряти"

#: stoke/job.py:478
#, python-format
msgid ""
"Windows To Go needs %s of temporary space in %s; only %s is free (set TMPDIR "
"to a larger location)"
msgstr "Windows To Go потребує %s тимчасового місця в %s; доступно лише %s (вкажіть у TMPDIR каталог із більшим обсягом вільного місця)"

#: stoke/job.py:481
msgid "Extracting install image..."
msgstr "Видобування установчого образу…"

#: stoke/job.py:498
msgid "image has no BCD template to build the boot store from"
msgstr "образ не містить шаблону BCD для побудови сховища завантаження"

#: stoke/layout.py:68
#, python-format
msgid "unknown partition scheme %s"
msgstr "невідома схема розділів %s"

#: stoke/layout.py:93
msgid "an MSR partition needs GPT"
msgstr "розділ MSR потребує GPT"

#: stoke/layout.py:110
msgid "persistence requested with no size"
msgstr "запитано збереження даних без вказання розміру"

#: stoke/layout.py:138
msgid "too many partitions"
msgstr "забагато розділів"

#: stoke/layout.py:146
#, python-format
msgid "%s does not fit on this drive"
msgstr "%s не вміщується на цьому диску"

#: stoke/layout.py:150 stoke/layout.py:155
msgid "drive is too small for this layout"
msgstr "диск замалий для цієї розмітки"

#: stoke/layout.py:247
#, python-format
msgid "%s did not appear after partitioning"
msgstr "%s не з'явився після розмітки"

#: stoke/linux.py:99
#, python-format
msgid "extlinux failed: %s"
msgstr "помилка extlinux: %s"

#: stoke/mountctl.py:82
#, python-format
msgid "%s is active swap; deactivate it first"
msgstr "%s є активним розділом підкачки; спочатку вимкніть його"

#: stoke/mountctl.py:93
#, python-format
msgid "%s is in use (%s); close anything using it and try again"
msgstr "%s використовується (%s); закрийте все, що його використовує, і спробуйте ще раз"

#: stoke/mountctl.py:128
#, python-format
msgid "could not mount %s (%s): %s"
msgstr "не вдалося змонтувати %s (%s): %s"

#: stoke/mountctl.py:128
msgid "no mount helper"
msgstr "немає помічника монтування"

#: stoke/util.py:147
#, python-format
msgid "'%s' is not available on this system%s"
msgstr "«%s» недоступне в цій системі%s"

#: stoke/util.py:180 stoke/wim.py:114
#, python-format
msgid "%s failed: %s"
msgstr "помилка %s: %s"

#: stoke/util.py:212
#, python-format
msgid "short write to %s at %s"
msgstr "неповний запис до %s за зміщенням %s"

#: stoke/util.py:226
#, python-format
msgid "missing payload file: %s"
msgstr "відсутній файл даних: %s"

#: stoke/wim.py:59 stoke/wim.py:75
#, python-format
msgid "%s is not a WIM file"
msgstr "%s не є файлом WIM"

#: stoke/wim.py:63
#, python-format
msgid "%s has no XML index"
msgstr "%s не містить XML-індексу"

#: stoke/wim.py:131
#, python-format
msgid "wimupdate failed: %s"
msgstr "помилка wimupdate: %s"

#: stoke/wim.py:170
#, python-format
msgid "wimapply failed: %s"
msgstr "помилка wimapply: %s"

#: stoke/windows.py:73
msgid "SYSTEM hive has no Setup key"
msgstr "кущ реєстру SYSTEM не містить розділу Setup"

#: stoke/windows.py:97
msgid "Applying Windows customization..."
msgstr "Застосування налаштувань Windows…"

#: stoke/windows.py:171
msgid "sources/boot.wim not found; cannot add the answer file"
msgstr "не знайдено sources/boot.wim; неможливо додати файл відповідей"

#: stoke/windows.py:187
msgid "Updating boot.wim..."
msgstr "Оновлення boot.wim…"

#: stoke/windows.py:272
#, python-format
msgid "%s\\%s not found on the media"
msgstr "%s\\%s не знайдено на носії"

#: stoke/windows.py:289
msgid ""
"media has \\minint but no /minint option and no \\i386: unsure how to boot it"
msgstr "носій містить \\minint, але немає параметра /minint і немає \\i386: незрозуміло, як його завантажувати"

#: stoke/windows.py:353
#, python-format
msgid "%s not found in %s"
msgstr "%s не знайдено в %s"

#: stoke/windows.py:385
msgid "no OS loader entry in the BCD template"
msgstr "у шаблоні BCD немає запису завантажувача ОС"

#: stoke/windows.py:480
msgid "Applying Windows image (this takes a while)..."
msgstr "Застосування образу Windows (це може тривати деякий час)…"

#: stoke/windows.py:488
msgid "applied image has no Windows directory"
msgstr "у застосованому образі немає каталогу Windows"

#: stoke/windows.py:500
msgid "applied image has no Windows\\Boot\\EFI"
msgstr "у застосованому образі немає каталогу Windows\\Boot\\EFI"

#: stoke/windows.py:558
#, python-format
msgid "could not mount %s (NTFS): neither ntfs3 nor ntfs-3g worked"
msgstr "не вдалося змонтувати %s (NTFS): не спрацював ні ntfs3, ні ntfs-3g"

#: stoke/writer.py:50
msgid ""
"only fixed-size VHD images can be written; convert dynamic VHD/VHDX with "
"qemu-img first"
msgstr "можна записувати лише VHD-образи фіксованого розміру; спочатку перетворіть динамічний VHD/VHDX за допомогою qemu-img"

#: stoke/writer.py:90
#, python-format
msgid "image is %s but the drive holds only %s"
msgstr "розмір образу %s, а на диску є лише %s"

#: stoke/writer.py:111
msgid "image is larger than the drive"
msgstr "образ більший за диск"

#: stoke/writer.py:156
#, python-format
msgid ""
"verification failed at offset %s: the drive does not hold what was written"
msgstr "перевірка не вдалася за зміщенням %s: вміст диска не збігається із записаним"
