#: stoke/bootrec.py:50
#, python-format
msgid "unknown MBR type %s"
msgstr "알 수 없는 MBR 유형 %s"

#: stoke/bootrec.py:119
msgid ""
"not enough space before the first partition for the boot loader (uncheck "
"'Add fixes for old BIOSes')"
msgstr "부트로더를 위한 공간이 첫 번째 파티션 앞에 부족합니다('오래된 BIOS용 수정 추가'의 선택을 해제하세요)"

#: stoke/bootrec.py:152
msgid "new volume does not have an NTFS boot sector"
msgstr "새 볼륨에 NTFS 부트 섹터가 없습니다"

#: stoke/bootrec.py:160
msgid "new volume does not have a FAT32 boot sector"
msgstr "새 볼륨에 FAT32 부트 섹터가 없습니다"

#: stoke/bootrec.py:192
msgid "new volume does not have a FAT16 boot sector"
msgstr "새 볼륨에 FAT16 부트 섹터가 없습니다"

#: stoke/bootrec.py:203
#, python-format
msgid "no boot record support for %s"
msgstr "%s에 대한 부트 레코드를 지원하지 않습니다"

#: stoke/cli.py:17
msgid "Writing a drive needs root: run through pkexec or sudo"
msgstr "드라이브 쓰기 실행에는 root 권한이 필요합니다: pkexec 또는 sudo를 통해 실행하세요"

#: stoke/cli.py:116 stoke/job.py:145
#, python-format
msgid "%s is not a disk"
msgstr "%s은(는) 디스크가 아닙니다"

#: stoke/extract.py:180
#, python-format
msgid "'%s' is %s: FAT32 cannot hold files over 4 GB. Use NTFS or exFAT."
msgstr "'%s'은(는) %s입니다: FAT32는 4GB가 넘는 파일을 저장할 수 없습니다. NTFS 또는 exFAT를 사용하세요."

#: stoke/extract.py:185
#, python-format
msgid "could not write %s: %s"
msgstr "%s을(를) 쓸 수 없습니다: %s"

#: stoke/extract.py:203
#, python-format
msgid ""
"splitting %s needs %s of temporary space in %s, only %s free. Use NTFS "
"instead of FAT32, or set TMPDIR to a larger location."
msgstr "%s을(를) 분할하려면 %s에 %s의 임시 공간이 필요하지만 %s만 사용 가능합니다. FAT32 대신 NTFS를 사용하거나 TMPDIR을 더 큰 공간으로 설정하세요."

#: stoke/extract.py:213
msgid "Splitting install.wim for FAT32..."
msgstr "FAT32용으로 install.wim 분할 중…"

#: stoke/fs.py:110 stoke/job.py:124 stoke/layout.py:163
#, python-format
msgid "unsupported file system %s"
msgstr "지원되지 않는 파일 시스템입니다: %s"

#: stoke/image.py:69
#, python-format
msgid "%s is not a file"
msgstr "%s은(는) 파일이 아닙니다"

#: stoke/job.py:96
#, python-format
msgid "unknown boot type %s"
msgstr "알 수 없는 부팅 유형입니다: %s"

#: stoke/job.py:120
msgid "scheme must be mbr or gpt"
msgstr "파티션 방식은 mbr 또는 gpt여야 합니다"

#: stoke/job.py:122
msgid "target must be bios, uefi or dual"
msgstr "대상 시스템은 bios, uefi 또는 dual이어야 합니다"

#: stoke/job.py:126
msgid "no image given"
msgstr "이미지가 지정되지 않았습니다"

#: stoke/job.py:128
msgid "no device given"
msgstr "장치가 지정되지 않았습니다"

#: stoke/job.py:130
msgid "GPT needs a UEFI target"
msgstr "GPT를 사용하려면 UEFI 대상이 필요합니다"

#: stoke/job.py:132
msgid "UEFI:NTFS needs an NTFS or exFAT main partition"
msgstr "UEFI:NTFS에는 NTFS 또는 exFAT 기본 파티션이 필요합니다"

#: stoke/job.py:144
#, python-format
msgid "%s holds the running system; refusing to write it"
msgstr "%s에는 실행 중인 시스템이 있어 쓰기를 거부합니다"

#: stoke/job.py:147
#, python-format
msgid "%s is an internal drive; refusing to write it"
msgstr "%s은(는) 내장 드라이브이므로 쓰기를 거부합니다"

#: stoke/job.py:149
#, python-format
msgid "%s is a loop device; refusing to write it"
msgstr "%s은(는) 루프 장치이므로 쓰기를 거부합니다"

#: stoke/job.py:158
msgid "Scanning image..."
msgstr "이미지를 검사하는 중…"

#: stoke/job.py:162
msgid "this ISO is not a hybrid image and cannot be written in DD mode"
msgstr "이 ISO는 하이브리드 이미지가 아니므로 DD 모드로 쓸 수 없습니다"

#: stoke/job.py:166
msgid "Windows To Go needs an image with sources/install.wim"
msgstr "Windows To Go에는 sources/install.wim이 포함된 이미지가 필요합니다"

#: stoke/job.py:168
msgid "Windows To Go needs NTFS"
msgstr "Windows To Go에는 NTFS가 필요합니다"

#: stoke/job.py:170
msgid "this image has files over 4 GB that cannot be split; use NTFS or exFAT"
msgstr "이 이미지에는 분할할 수 없는 4GB가 넘는 파일이 있습니다. NTFS 또는 exFAT를 사용하세요"

#: stoke/job.py:172
msgid "this image does not support a persistent partition"
msgstr "이 이미지는 지속 파티션을 지원하지 않습니다"

#: stoke/job.py:174
msgid ""
"this image has files over 4 GB; FAT32 cannot hold them, use NTFS or exFAT"
msgstr "이 이미지에는 4GB가 넘는 파일이 있습니다. FAT32로는 저장할 수 없으므로 NTFS 또는 exFAT를 사용하세요"

#: stoke/job.py:176
#, python-format
msgid "the image needs %s but the drive has %s"
msgstr "이 이미지에는 %s이(가) 필요하지만 드라이브에는 %s만 있습니다"

#: stoke/job.py:228
msgid "Writing image..."
msgstr "이미지를 쓰는 중…"

#: stoke/job.py:230 stoke/job.py:393
msgid "Finalizing..."
msgstr "마무리하는 중…"

#: stoke/job.py:234
msgid "Zeroing drive..."
msgstr "드라이브를 0으로 초기화하는 중…"

#: stoke/job.py:239
msgid "Creating partition table..."
msgstr "파티션 테이블을 만드는 중…"

#: stoke/job.py:264
msgid "Formatting..."
msgstr "포맷하는 중…"

#: stoke/job.py:285
msgid "Writing boot records..."
msgstr "부트 레코드를 쓰는 중…"

#: stoke/job.py:321
msgid "Copying files..."
msgstr "파일을 복사하는 중…"

#: stoke/job.py:321
msgid "Preparing volume..."
msgstr "볼륨을 준비하는 중…"

#: stoke/job.py:333
msgid "could not read the partition GUIDs back from the new table"
msgstr "새 테이블에서 파티션 GUID를 다시 읽을 수 없습니다"

#: stoke/job.py:383
msgid "Applying customization..."
msgstr "사용자 지정을 적용하는 중…"

#: stoke/job.py:383
msgid "Finalizing files..."
msgstr "파일을 마무리하는 중…"

#: stoke/job.py:434
msgid "Checking for bad blocks..."
msgstr "배드 블록을 확인하는 중…"

#: stoke/job.py:465
#, python-format
msgid ""
"bad blocks check found %d bad block(s); this drive should not be trusted"
msgstr "배드 블록 검사에서 %d개의 배드 블록을 발견했습니다. 이 드라이브는 신뢰할 수 없습니다"

#: stoke/job.py:478
#, python-format
msgid ""
"Windows To Go needs %s of temporary space in %s; only %s is free (set TMPDIR "
"to a larger location)"
msgstr "Windows To Go는 %s에 %s의 임시 공간이 필요하지만 %s만 사용 가능합니다(TMPDIR을 더 큰 공간으로 설정하세요)"

#: stoke/job.py:481
msgid "Extracting install image..."
msgstr "설치 이미지를 추출하는 중…"

#: stoke/job.py:498
msgid "image has no BCD template to build the boot store from"
msgstr "이미지에 부트 저장소를 만들 BCD 템플릿이 없습니다"

#: stoke/layout.py:68
#, python-format
msgid "unknown partition scheme %s"
msgstr "알 수 없는 파티션 방식입니다: %s"

#: stoke/layout.py:93
msgid "an MSR partition needs GPT"
msgstr "MSR 파티션에는 GPT가 필요합니다"

#: stoke/layout.py:110
msgid "persistence requested with no size"
msgstr "지속성이 요청되었지만 크기가 지정되지 않았습니다"

#: stoke/layout.py:138
msgid "too many partitions"
msgstr "파티션이 너무 많습니다"

#: stoke/layout.py:146
#, python-format
msgid "%s does not fit on this drive"
msgstr "%s은(는) 이 드라이브에 맞지 않습니다"

#: stoke/layout.py:150 stoke/layout.py:155
msgid "drive is too small for this layout"
msgstr "이 레이아웃을 사용하기에는 드라이브 용량이 너무 작습니다"

#: stoke/layout.py:247
#, python-format
msgid "%s did not appear after partitioning"
msgstr "파티션 생성 후 %s이(가) 나타나지 않았습니다"

#: stoke/linux.py:99
#, python-format
msgid "extlinux failed: %s"
msgstr "extlinux가 실패했습니다: %s"

#: stoke/mountctl.py:82
#, python-format
msgid "%s is active swap; deactivate it first"
msgstr "%s은(는) 사용 중인 스왑입니다. 먼저 비활성화하세요"

#: stoke/mountctl.py:93
#, python-format
msgid "%s is in use (%s); close anything using it and try again"
msgstr "%s은(는) 사용 중입니다(%s). 사용 중인 항목을 닫고 다시 시도하세요"

#: stoke/mountctl.py:128
#, python-format
msgid "could not mount %s (%s): %s"
msgstr "%s(%s)을(를) 마운트할 수 없습니다: %s"

#: stoke/mountctl.py:128
msgid "no mount helper"
msgstr "마운트 도우미가 없습니다"

#: stoke/util.py:147
#, python-format
msgid "'%s' is not available on this system%s"
msgstr "'%s'은(는) 이 시스템에서 사용할 수 없습니다%s"

#: stoke/util.py:180 stoke/wim.py:114
#, python-format
msgid "%s failed: %s"
msgstr "%s이(가) 실패했습니다: %s"

#: stoke/util.py:212
#, python-format
msgid "short write to %s at %s"
msgstr "%s의 %s 위치에 쓰기가 불완전했습니다"

#: stoke/util.py:226
#, python-format
msgid "missing payload file: %s"
msgstr "페이로드 파일이 없습니다: %s"

#: stoke/wim.py:59 stoke/wim.py:75
#, python-format
msgid "%s is not a WIM file"
msgstr "%s은(는) WIM 파일이 아닙니다"

#: stoke/wim.py:63
#, python-format
msgid "%s has no XML index"
msgstr "%s에 XML 인덱스가 없습니다"

#: stoke/wim.py:131
#, python-format
msgid "wimupdate failed: %s"
msgstr "wimupdate가 실패했습니다: %s"

#: stoke/wim.py:170
#, python-format
msgid "wimapply failed: %s"
msgstr "wimapply가 실패했습니다: %s"

#: stoke/windows.py:73
msgid "SYSTEM hive has no Setup key"
msgstr "SYSTEM 하이브에 Setup 키가 없습니다"

#: stoke/windows.py:97
msgid "Applying Windows customization..."
msgstr "Windows 사용자 지정을 적용하는 중…"

#: stoke/windows.py:171
msgid "sources/boot.wim not found; cannot add the answer file"
msgstr "sources/boot.wim을 찾을 수 없어 응답 파일을 추가할 수 없습니다"

#: stoke/windows.py:187
msgid "Updating boot.wim..."
msgstr "boot.wim을 업데이트하는 중…"

#: stoke/windows.py:272
#, python-format
msgid "%s\\%s not found on the media"
msgstr "미디어에서 %s\\%s을(를) 찾을 수 없습니다"

#: stoke/windows.py:289
msgid ""
"media has \\minint but no /minint option and no \\i386: unsure how to boot it"
msgstr "미디어에 \\minint는 있지만 /minint 옵션과 \\i386이 없어 부팅 방법을 확인할 수 없습니다"

#: stoke/windows.py:353
#, python-format
msgid "%s not found in %s"
msgstr "%s에서 %s을(를) 찾을 수 없습니다"

#: stoke/windows.py:385
msgid "no OS loader entry in the BCD template"
msgstr "BCD 템플릿에 OS 로더 항목이 없습니다"

#: stoke/windows.py:480
msgid "Applying Windows image (this takes a while)..."
msgstr "Windows 이미지를 적용하는 중입니다(시간이 걸립니다)…"

#: stoke/windows.py:488
msgid "applied image has no Windows directory"
msgstr "적용한 이미지에 Windows 디렉터리가 없습니다"

#: stoke/windows.py:500
msgid "applied image has no Windows\\Boot\\EFI"
msgstr "적용한 이미지에 Windows\\Boot\\EFI가 없습니다"

#: stoke/windows.py:558
#, python-format
msgid "could not mount %s (NTFS): neither ntfs3 nor ntfs-3g worked"
msgstr "%s(NTFS)을(를) 마운트할 수 없습니다: ntfs3와 ntfs-3g 모두 실패했습니다"

#: stoke/writer.py:50
msgid ""
"only fixed-size VHD images can be written; convert dynamic VHD/VHDX with "
"qemu-img first"
msgstr "고정 크기 VHD 이미지만 쓸 수 있습니다. 동적 VHD/VHDX는 먼저 qemu-img로 변환하세요"

#: stoke/writer.py:90
#, python-format
msgid "image is %s but the drive holds only %s"
msgstr "이미지 크기는 %s이지만 드라이브 용량은 %s밖에 없습니다"

#: stoke/writer.py:111
msgid "image is larger than the drive"
msgstr "이미지가 드라이브보다 큽니다"

#: stoke/writer.py:156
#, python-format
msgid ""
"verification failed at offset %s: the drive does not hold what was written"
msgstr "오프셋 %s에서 검증에 실패했습니다: 드라이브 내용이 기록된 데이터와 일치하지 않습니다"