<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Stoke</vendor>
  <vendor_url>https://github.com/dresden196/stoke</vendor_url>

  <!--
    Writing a USB drive: partitioning, formatting, boot records. The engine
    refuses the disk the system runs from whatever it is asked, and lists
    only removable drives unless told otherwise, but it is still a program
    that erases disks, so it asks for the administrator password.

    auth_admin_keep: making two sticks in a row should not mean typing the
    password twice. The window starts the service once and keeps it.
  -->
  <action id="io.github.dresden196.stoke.write">
    <description>Write a bootable USB drive</description>
    <message>Authentication is required to write a USB drive</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/stoke</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
