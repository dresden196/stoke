<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.dresden196.stoke.gtk</id>
  <name>Stoke</name>
  <summary>Write bootable USB drives</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <developer id="io.github.dresden196">
    <name>Dresden Wildey</name>
  </developer>
  <description>
    <p>
      Stoke makes bootable USB drives from ISO and disk images, the way
      Rufus does on Windows: Windows install media on NTFS with UEFI:NTFS,
      the Windows 11 hardware-check bypass and answer files, Windows To Go,
      Linux ISOs with a persistent partition, FreeDOS, and plain DD writes
      with verification.
    </p>
    <p>
      This is the GNOME window over the stoke engine; a KDE window is
      available as well, and both may be installed together.
    </p>
  </description>
  <launchable type="desktop-id">io.github.dresden196.stoke.gtk.desktop</launchable>
  <url type="homepage">https://github.com/dresden196/stoke</url>
  <url type="bugtracker">https://github.com/dresden196/stoke/issues</url>
  <url type="vcs-browser">https://github.com/dresden196/stoke</url>
  <content_rating type="oars-1.1"/>
  <categories>
    <category>System</category>
    <category>Utility</category>
  </categories>
  <keywords>
    <keyword>usb</keyword>
    <keyword>iso</keyword>
    <keyword>bootable</keyword>
    <keyword>rufus</keyword>
  </keywords>
  <requires>
    <display_length compare="ge">480</display_length>
  </requires>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
    <control>touch</control>
  </supports>
  <releases>
