# Maintainer: Dresden Wildey <dresden196@gmail.com>
#
# The USB writer's GNOME window. Like stoke-qt (the KDE one) it draws what
# the stoke engine reports and hands it a job; the two front-ends share
# the engine package and may be installed side by side.
pkgname=stoke-gtk
# fubuki-gtk was this package's name up to 0.2.3.
provides=('fubuki-gtk')
conflicts=('fubuki-gtk')
replaces=('fubuki-gtk')
pkgver=0.3.0
pkgrel=1
pkgdesc="Stoke bootable USB writer: the GNOME window"
arch=('any')
url="https://github.com/dresden196/stoke"
license=('GPL-3.0-or-later')
depends=('stoke' 'python' 'python-gobject' 'gtk4' 'libadwaita' 'polkit')
makedepends=('gettext')

package() {
    install -Dm755 "$startdir/bin/stoke-gtk" "$pkgdir/usr/bin/stoke-gtk"
    ln -s stoke-gtk "$pkgdir/usr/bin/fubuki-gtk"
    install -d "$pkgdir/usr/lib/stoke-gtk/stoke_gtk"
    install -Dm644 "$startdir"/stoke_gtk/*.py -t "$pkgdir/usr/lib/stoke-gtk/stoke_gtk/"
    install -Dm644 "$startdir/io.github.dresden196.stoke.gtk.desktop" \
        "$pkgdir/usr/share/applications/io.github.dresden196.stoke.gtk.desktop"
    install -Dm644 "$startdir/io.github.dresden196.stoke.gtk.metainfo.xml" \
        "$pkgdir/usr/share/metainfo/io.github.dresden196.stoke.gtk.metainfo.xml"
    # The icon (hicolor/scalable/apps/stoke.svg) comes with the engine
    # package, which both front-ends depend on.

    # Window strings, when a catalog exists (po/<lang>/stoke-gtk.po).
    for po in "$startdir"/po/*/stoke-gtk.po; do
        [ -f "$po" ] || continue
        lang=$(basename "$(dirname "$po")")
        install -d "$pkgdir/usr/share/locale/$lang/LC_MESSAGES"
        msgfmt -o "$pkgdir/usr/share/locale/$lang/LC_MESSAGES/stoke-gtk.mo" "$po"
    done
}
